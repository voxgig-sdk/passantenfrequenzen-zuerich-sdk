      type: "`$STRING`"
    }
    {
      name: "count"
      req: false
      short: "Anzahl gezählter Passanten"
      type: "`$INTEGER`"
    }
    {
      name: "direction"
      req: false
      short: "Laufrichtung der Passanten"
      type: "`$STRING`"
    }
    {
      name: "location"
      req: false
      short: "Name des Messgebiets"
      type: "`$STRING`"
    }
    {
