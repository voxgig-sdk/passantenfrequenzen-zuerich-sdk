      short: "Wetterbedingungen während der Messung"
      type: "`$STRING`"
    }
    {
      name: "zone"
      req: false
      short: "Zone (1-3 für Bürgersteigseiten/Mitte, 99 für nicht zuordenbar)"
      type: "`$INTEGER`"
    }
  ]

  name: "frequenzen"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: "2023-12-31T23:59:59Z"
